# Merged over x86_64 tinyconfig. Every line here must survive into the final .config. The guest
# loads no modules, so every driver it needs is built in.
CONFIG_64BIT=y
CONFIG_PRINTK=y
CONFIG_EARLY_PRINTK=y
CONFIG_BINFMT_ELF=y
CONFIG_BINFMT_SCRIPT=y
CONFIG_MULTIUSER=y
CONFIG_FUTEX=y
CONFIG_EPOLL=y
CONFIG_EVENTFD=y
CONFIG_TIMERFD=y
CONFIG_SIGNALFD=y
CONFIG_POSIX_TIMERS=y
# The agent's journal takes an exclusive lock.
CONFIG_FILE_LOCKING=y
CONFIG_TTY=y
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_HYPERVISOR_GUEST=y
CONFIG_PARAVIRT=y
CONFIG_KVM_GUEST=y
# One CPU per vCPU, found through the sandbox's MP table.
CONFIG_SMP=y
# The sandbox's CUBEBOT_GUEST_VCPUS limit.
CONFIG_NR_CPUS=32
CONFIG_X86_MPPARSE=y
# Guest init mounts these; the kernel mounts devtmpfs on /dev itself.
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
CONFIG_SHMEM=y
CONFIG_TMPFS=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
# virtio-mmio devices declared on the kernel command line.
CONFIG_VIRTIO_MENU=y
CONFIG_VIRTIO=y
CONFIG_VIRTIO_MMIO=y
CONFIG_VIRTIO_MMIO_CMDLINE_DEVICES=y
# Root and workspace disks.
CONFIG_BLOCK=y
CONFIG_BLK_DEV=y
CONFIG_VIRTIO_BLK=y
CONFIG_EXT4_FS=y
# Network on a tap, configured by the kernel's ip= parameter before init runs.
CONFIG_NET=y
CONFIG_UNIX=y
CONFIG_INET=y
CONFIG_IP_PNP=y
CONFIG_NETDEVICES=y
CONFIG_NET_CORE=y
CONFIG_VIRTIO_NET=y
# The control channel to the sandbox.
CONFIG_VSOCKETS=y
CONFIG_VIRTIO_VSOCKETS=y
