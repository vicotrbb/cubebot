# Development only. Replace the password before starting the optional database.
POSTGRES_PASSWORD=cubebot-local-development
POSTGRES_PORT=5432
# Rust reads exported variables; it does not automatically load this file.
CUBEBOT_BIND_ADDR=127.0.0.1:8080
RUST_LOG=info

# Export a real connection URL to enable identity and migrations.
# CUBEBOT_DATABASE_URL=postgres://USER:PASSWORD@127.0.0.1:5432/cubebot
# Bootstrap credentials are only read by cubebot-admin, never by the HTTP service.
# CUBEBOT_BOOTSTRAP_LOGIN=admin
# CUBEBOT_BOOTSTRAP_PASSWORD=choose-a-long-unique-password
