---
import Page from './Page.astro'
import PageHead from '../components/PageHead.astro'
import { resources, repo } from '../data/site'

interface Props {
  title: string
  description: string
  heading: string
  lede: string
  tones?: ('orange' | 'sage' | 'paper' | 'wood')[]
  source?: string
}
const { title, description, heading, lede, tones, source } = Astro.props
const path = Astro.url.pathname.replace(/\/?$/, '/')
---

<Page title={title} description={description} current="resources">
  <PageHead title={heading} lede={lede} tones={tones}>
    <slot name="actions" />
  </PageHead>
  <div class="wrap doc">
    <nav class="doc__nav" aria-label="Resources">
      <ul>
        {
          resources.map((item) => (
            <li>
              <a href={item.href} aria-current={item.href === path ? 'page' : undefined}>
                {item.title}
              </a>
            </li>
          ))
        }
      </ul>
      {source && <a class="doc__source" href={`${repo}/blob/main/${source}`}>Read the source document</a>}
    </nav>
    <div class="sheet">
      <article class="prose">
        <slot />
      </article>
      <div class="slab sheet__shelf" aria-hidden="true"></div>
    </div>
  </div>
</Page>

<style>
  .doc {
    display: grid;
    grid-template-columns: 220px minmax(0, 1fr);
    gap: clamp(28px, 5vw, 72px);
    align-items: start;
    padding-bottom: clamp(56px, 9vw, 120px);
  }
  .doc__nav {
    position: sticky;
    top: 96px;
    display: grid;
    gap: 18px;
  }
  .doc__nav ul {
    display: grid;
    gap: 2px;
    padding: 8px;
    border-radius: 14px;
    border-bottom: 4px solid var(--wood-deep);
    background: var(--wood);
  }
  .doc__nav a {
    display: block;
    padding: 9px 12px;
    border-radius: 9px;
    font-weight: 600;
    text-decoration: none;
  }
  .doc__nav a:hover {
    background: rgb(255 253 249 / 0.45);
  }
  .doc__nav a[aria-current='page'] {
    background: var(--paper);
    box-shadow: 0 6px 12px -8px rgb(var(--shadow) / 0.5);
  }
  .doc__source {
    padding-inline: 12px;
    color: var(--ink-soft);
    font-size: 0.9rem;
    font-weight: 600;
  }

  .sheet {
    min-width: 0;
    max-width: 82ch;
  }
  .prose {
    position: relative;
    z-index: 1;
    margin-inline: 14px;
    padding: clamp(24px, 4vw, 52px);
    border-radius: 6px 6px 2px 2px;
    background: var(--paper);
    box-shadow:
      inset 0 -3px 0 var(--paper-deep),
      0 14px 10px -12px rgb(var(--shadow) / 0.35);
  }
  .sheet__shelf {
    margin-top: -2px;
  }
  .prose :global(h2) {
    max-width: none;
    margin-top: 2.4em;
    font-size: clamp(1.6rem, 2.6vw, 2.1rem);
    scroll-margin-top: 96px;
  }
  .prose :global(h2:first-child) {
    margin-top: 0;
  }
  .prose :global(h3) {
    margin-top: 1.8em;
    font-size: 1.2rem;
  }
  .prose :global(p),
  .prose :global(ul),
  .prose :global(ol),
  .prose :global(table),
  .prose :global(.command),
  .prose :global(pre),
  .prose :global(.callout) {
    margin-top: 1em;
  }
  .prose :global(h2 + p),
  .prose :global(h3 + p) {
    margin-top: 0.7em;
  }
  .prose :global(ul) {
    display: grid;
    gap: 0.45em;
    padding-left: 1.3em;
    list-style: none;
  }
  .prose :global(ul > li),
  .prose :global(ol > li) {
    position: relative;
    min-width: 0;
  }
  .prose :global(li code),
  .prose :global(p code) {
    overflow-wrap: anywhere;
  }
  .prose :global(ul > li)::before {
    content: '';
    position: absolute;
    left: -1.1em;
    top: 0.55em;
    width: 0.5em;
    height: 0.5em;
    border-radius: 2px;
    background: var(--orange);
    box-shadow: 0 2px 0 var(--orange-deep);
  }
  .prose :global(ol) {
    display: grid;
    gap: 0.6em;
    padding-left: 1.6em;
    list-style: decimal;
  }
  .prose :global(ol > li::marker) {
    font-weight: 800;
    color: var(--orange-base);
  }
  .prose :global(code) {
    padding: 0.1em 0.35em;
    border-radius: 5px;
    background: var(--desk-deep);
    font-family: ui-monospace, 'SF Mono', Menlo, Consolas, monospace;
    font-size: 0.88em;
  }
  .prose :global(pre code) {
    padding: 0;
    background: none;
  }
  .prose :global(pre:not(.install)) {
    padding: 16px 18px;
    overflow-x: auto;
    border-radius: var(--radius);
    background: var(--ink);
    color: var(--paper);
    font-size: 0.875rem;
    line-height: 1.6;
  }
  .prose :global(pre:not(.install) code) {
    color: inherit;
  }
  .prose :global(table) {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.95rem;
    font-variant-numeric: tabular-nums;
  }
  .prose :global(th),
  .prose :global(td) {
    padding: 10px 12px 10px 0;
    border-bottom: 2px solid rgb(var(--shadow) / 0.08);
    text-align: left;
    vertical-align: top;
  }
  .prose :global(th) {
    font-weight: 800;
  }
  .prose :global(.table) {
    overflow-x: auto;
  }
  .prose :global(.callout) {
    padding: 16px 18px;
    border-radius: 12px;
    background: var(--desk);
    border-bottom: 3px solid var(--desk-deep);
  }
  .prose :global(.callout strong:first-child) {
    display: block;
    margin-bottom: 4px;
  }
  .prose :global(.chip) {
    font-size: 0.8rem;
    padding: 3px 9px 4px;
  }

  @media (max-width: 860px) {
    .doc {
      grid-template-columns: minmax(0, 1fr);
    }
    .doc__nav {
      position: static;
      order: 2;
    }
    .doc__nav ul {
      grid-template-columns: 1fr 1fr;
    }
    .prose {
      margin-inline: 8px;
      padding: 22px 18px;
    }
  }
</style>
