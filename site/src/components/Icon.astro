---
type Name =
  | 'github'
  | 'arrow'
  | 'check'
  | 'brush'
  | 'dot'
  | 'heart'
  | 'star'
  | 'search'
  | 'external'
  | 'chevron'
  | 'menu'
  | 'copy'
  | 'download'

interface Props {
  name: Name
