{
  "db_name": "PostgreSQL",
  "query": "\n            SELECT m.title, m.description, extract(epoch FROM m.starts_at)::bigint AS starts,\n                extract(epoch FROM m.ends_at)::bigint AS ends, m.link_token AS token,\n                h.profile->>'time_zone' AS zone\n            FROM meetings m\n            JOIN human_accounts h ON h.id=$2\n            WHERE m.id=$1\n            ",
