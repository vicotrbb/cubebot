{
  "db_name": "PostgreSQL",
  "query": "\n            SELECT r.id, r.name, r.agent_id AS agent, a.name AS agent_name, r.trigger_event AS \"event!\", r.enabled\n            FROM routines r JOIN agents a ON a.id = r.agent_id\n            WHERE r.trigger_connection = $1\n            ORDER BY a.name, r.name\n            ",
