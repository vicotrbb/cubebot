  "query": "\n            SELECT\n                id AS \"id!\",\n                account_id AS \"account_id!\",\n                issuer AS \"issuer!\",\n                subject AS \"subject!\",\n                active AS \"active!\",\n                revision AS \"revision!\"\n            FROM oidc_bindings\n            WHERE ($1::uuid IS NULL OR id > $1)\n            ORDER BY id\n            LIMIT 100\n            ",
