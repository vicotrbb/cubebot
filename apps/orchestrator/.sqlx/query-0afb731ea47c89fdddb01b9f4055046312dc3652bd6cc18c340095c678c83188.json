  "query": "\n            SELECT e.id, e.turn_id, e.payload #- '{outcome,image}' AS \"payload!\"\n            FROM turn_events e\n            JOIN chat_turns t ON t.id=e.turn_id\n            WHERE t.conversation_id=$1 AND e.id>$2\n            ORDER BY e.id\n            LIMIT 100\n            ",
