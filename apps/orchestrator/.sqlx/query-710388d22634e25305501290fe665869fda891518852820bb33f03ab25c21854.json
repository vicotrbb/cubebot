{
  "db_name": "PostgreSQL",
  "query": "\n            SELECT s.id, s.name, s.revision, r.description, (to_jsonb(r.created_at) #>> '{}') AS \"updated_at!\"\n            FROM skills s\n            JOIN skill_revisions r ON r.skill_id=s.id AND r.revision=s.revision\n            WHERE s.id=$1\n            ",
