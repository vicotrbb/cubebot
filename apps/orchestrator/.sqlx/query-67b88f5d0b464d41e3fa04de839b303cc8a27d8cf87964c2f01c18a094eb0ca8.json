  "query": "\n            SELECT\n                id AS \"id!\",\n                login AS \"login!\",\n                role = 'administrator' AS \"administrator!\",\n                active AS \"active!\",\n                revision AS \"revision!\"\n            FROM human_accounts\n            WHERE $1::uuid IS NULL OR id > $1\n            ORDER BY id\n            LIMIT 100\n            ",
