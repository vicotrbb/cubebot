{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT m.id, m.room_id, r.name, m.message, m.sequence, m.actor_id\n        FROM room_messages m\n        JOIN rooms r ON r.id=m.room_id\n        WHERE m.routing='routing' AND NOT r.task\n        ORDER BY m.sequence\n        LIMIT 1\n        ",
