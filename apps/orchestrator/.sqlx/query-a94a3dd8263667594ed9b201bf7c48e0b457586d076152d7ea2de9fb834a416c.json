{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT t.id AS turn, t.room_message_id AS \"room_message_id!\", t.conversation_id AS agent_id, a.name AS agent, t.status, t.response, t.error\n        FROM chat_turns t\n        JOIN agents a ON a.id=t.conversation_id\n        WHERE t.room_message_id=ANY($1)\n        ORDER BY t.sequence\n        ",
