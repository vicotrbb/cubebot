  "query": "\n            SELECT r.agent_id, a.name, r.backup_id, EXTRACT(EPOCH FROM r.restored_at)::bigint AS restored,\n                r.error\n            FROM workspace_restores r JOIN agents a ON a.id=r.agent_id\n            ORDER BY a.name\n            ",
