  "db_name": "PostgreSQL",
  "query": "\n            SELECT p.id, p.slug, p.name, p.description, p.icon, p.agent_id, g.name AS agent_name,\n                p.tools, p.desired, p.updating, p.reported, p.memory,\n                (to_jsonb(p.updated_at) #>> '{}') AS \"updated_at!\"\n            FROM apps p\n            JOIN agents g ON g.id = p.agent_id\n            WHERE p.slug = $1\n            ",
