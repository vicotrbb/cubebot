  "query": "\n        SELECT id, schedule AS \"schedule!\", time_zone\n        FROM routines\n        WHERE enabled AND next_at <= clock_timestamp() AND schedule IS NOT NULL\n        ORDER BY next_at\n        LIMIT 64\n        FOR UPDATE SKIP LOCKED\n        ",
