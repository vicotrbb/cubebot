  "query": "\n        SELECT\n            id AS \"id!\",\n            login AS \"login!\",\n            accepted_by AS \"accepted_by?\",\n            accept_request_id AS \"accept_request_id?\"\n        FROM invitations\n        WHERE token_hash = $1\n            AND expires_at > clock_timestamp()\n            AND revoked_by IS NULL\n        ",
