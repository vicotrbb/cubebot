{
  "db_name": "PostgreSQL",
  "query": "\n            SELECT c.id, c.parent_turn_id AS \"parent_turn_id!\", c.conversation_id AS agent_id, a.name AS agent, c.status, c.awaited, c.response, c.error\n            FROM chat_turns c\n            JOIN agents a ON a.id=c.conversation_id\n            WHERE c.parent_turn_id=ANY($1)\n            ORDER BY c.sequence\n            ",
