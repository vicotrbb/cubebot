  "query": "\n        SELECT r.task, r.lead_agent_id,\n            (SELECT m.agent_id FROM teams t JOIN team_members m ON m.team_id=t.id AND m.reports_to IS NULL WHERE t.room_id=r.id AND t.deleted_at IS NULL) AS manager\n        FROM rooms r\n        WHERE r.id=$1\n        ",
