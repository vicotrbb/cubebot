{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT c.id, a.name, c.status, c.response, c.error\n        FROM chat_turns c\n        JOIN agents a ON a.id=c.conversation_id\n        WHERE c.parent_turn_id=$1 AND c.awaited\n        ORDER BY c.sequence\n        ",
