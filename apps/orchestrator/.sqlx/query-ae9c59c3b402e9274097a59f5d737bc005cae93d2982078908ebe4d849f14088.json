{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT s.name, s.revision, r.description, i.revision AS \"installed?\"\n        FROM skills s\n        JOIN skill_revisions r ON r.skill_id=s.id AND r.revision=s.revision\n        LEFT JOIN skill_installations i ON i.skill_id=s.id AND i.agent_id=$1\n        ORDER BY s.name\n        LIMIT 200\n        ",
