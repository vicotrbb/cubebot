  "query": "\n        SELECT m.id, m.room_id, r.name, m.message, m.sequence\n        FROM room_messages m\n        JOIN rooms r ON r.id=m.room_id\n        WHERE m.routing='routing'\n        ORDER BY m.sequence\n        LIMIT 1\n        ",
