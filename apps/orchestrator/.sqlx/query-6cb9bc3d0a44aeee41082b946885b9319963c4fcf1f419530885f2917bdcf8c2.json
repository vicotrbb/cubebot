  "query": "\n        SELECT w.agent_id, a.name, w.status, w.bytes, w.sha256, w.error\n        FROM backup_workspaces w JOIN agents a ON a.id=w.agent_id\n        WHERE w.backup_id=$1 ORDER BY a.name\n        ",
