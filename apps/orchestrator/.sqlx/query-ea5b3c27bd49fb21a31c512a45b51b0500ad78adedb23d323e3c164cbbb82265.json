{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT m.id AS message, m.room_id AS room, r.task\n        FROM chat_turns t\n        JOIN room_messages m ON m.id=t.room_message_id\n        JOIN rooms r ON r.id=m.room_id\n        WHERE t.id=$1 AND t.parent_turn_id IS NULL\n        ",
