  "query": "\n        SELECT a.id, a.role = 'administrator' AS \"administrator!\",\n               i.owner_id IS NOT DISTINCT FROM a.id AS \"owner!\"\n        FROM human_accounts a CROSS JOIN installation i\n        WHERE a.id = $1\n        FOR UPDATE OF a\n        ",
