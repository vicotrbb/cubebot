{
  "db_name": "PostgreSQL",
  "query": "\n            SELECT m.id, m.revision, m.content, r.turn_id AS source_turn, r.dream_run_id AS source_dream, r.human_id IS NOT NULL AS \"edited_by_human!\"\n            FROM memories m\n            JOIN memory_revisions r ON r.memory_id=m.id AND r.revision=m.revision\n            WHERE m.id=$1\n            ",
