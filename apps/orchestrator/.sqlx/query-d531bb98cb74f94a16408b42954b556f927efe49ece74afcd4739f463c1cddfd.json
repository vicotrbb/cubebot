  "query": "\n            SELECT p.owner, p.credential, p.context_window\n            FROM agents g\n            JOIN human_accounts h ON h.id = g.created_by AND h.active\n            JOIN personal_providers p ON p.owner = g.created_by AND p.provider = $2\n            WHERE g.id = $1\n            ",
