  "query": "\n            SELECT agent_id AS \"agent!: AgentId\",\n                   attempt_id AS \"attempt!: AttemptId\",\n                   epoch AS \"epoch!\",\n                   version AS \"version!\"\n            FROM runtime_session_access\n            WHERE token_hash = $1\n              AND recovery\n              AND (NOT $2 OR active)\n            ",
