  "query": "\n        SELECT s.id, s.revision, r.description, r.files AS \"files: Json<Files>\"\n        FROM skills s\n        JOIN skill_revisions r ON r.skill_id=s.id AND r.revision=s.revision\n        WHERE s.name=$1\n        ",
