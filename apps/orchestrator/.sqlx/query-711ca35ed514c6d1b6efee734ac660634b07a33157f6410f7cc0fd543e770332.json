{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT r.agent_id AS agent, r.id, r.name, r.schedule, r.time_zone, r.enabled\n        FROM routines r JOIN agents a ON a.id = r.agent_id\n        WHERE a.created_by = $1 AND a.desired_state <> 'retired'\n        ORDER BY r.id\n        ",
