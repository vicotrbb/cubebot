{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT a.turn_id, f.id, f.name, f.content_type, b.size\n        FROM turn_attachments a\n        JOIN files f ON f.id=a.file_id\n        JOIN blobs b ON b.id=f.blob_id\n        WHERE a.turn_id=ANY($1) AND NOT a.inbound\n        ORDER BY a.created_at\n        ",
