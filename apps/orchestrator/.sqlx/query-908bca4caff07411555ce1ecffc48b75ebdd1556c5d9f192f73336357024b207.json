{
  "db_name": "PostgreSQL",
  "query": "\n            SELECT x.id, x.page_id AS page, x.name, x.content_type, b.size,\n                (to_jsonb(x.created_at) #>> '{}') AS \"created_at!\"\n            FROM kb_attachments x JOIN blobs b ON b.id = x.blob_id\n            WHERE x.page_id=$1\n            ORDER BY x.created_at\n            ",
